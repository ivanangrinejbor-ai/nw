# Set default behaviour, in case users don't have core.autocrlf set.
* text=auto
# Explicitly declare text files we want to always be normalized and converted 
# to native line endings on checkout.
*.java text
*.xml  text
*.txt  text
*.md   text
# Denote all files that are truly binary and should not be modified.
# (binary is a macro for -text -diff)
*.jar  binary
*.so   binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.bmp  binary
*.mp3  binary
*.zip  binary
# For more info see
# https://timclem.wordpress.com/2012/03/01/mind-the-end-of-your-line/
catroid/build/outputs/apk/runtime/template/catroid-runtime-template.apk filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
desktop-runtime/launch4j/**/*.exe filter=lfs diff=lfs merge=lfs -text
desktop-runtime/launch4j/**/*.jar filter=lfs diff=lfs merge=lfs -text
