<?xml version="1.0" encoding="utf-8"?>
<!-- Современная панель меню-паузы сцены: тёмный полупрозрачный фон со скруглённым верхом. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#F2101826"
        android:endColor="#F21B2739" />
    <corners
        android:topLeftRadius="28dp"
        android:topRightRadius="28dp" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>
