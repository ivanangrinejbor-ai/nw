<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="oval">
                    <solid android:color="@color/ai_send_disabled" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="315"
                        android:startColor="@color/ai_send_start"
                        android:endColor="@color/ai_send_end" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
