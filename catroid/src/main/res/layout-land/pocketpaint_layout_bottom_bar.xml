<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:gravity="center"
    tools:showIn="@layout/activity_pocketpaint_main">

    <LinearLayout
        android:id="@+id/pocketpaint_tools_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Row 1: Brush, Hand, Eraser, Line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/pocketpaint_tools_brush"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_brush">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_brush" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_brush" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pocketpaint_tools_hand"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_hand">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_hand" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_hand" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pocketpaint_tools_eraser"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_eraser">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_eraser" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_eraser" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pocketpaint_tools_line"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_line">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_line" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_line" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Shape, Fill, Spray, Cursor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/pocketpaint_tools_rectangle"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_shape">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_rectangle" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_shape" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pocketpaint_tools_fill"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_fill">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_fill" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_fill" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pocketpaint_tools_spray_can"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_spray_can">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_spray_can" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_spray_can" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pocketpaint_tools_cursor"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_cursor">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_cursor" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_cursor" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 3: Text, Clipboard, Transform, Import -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/pocketpaint_tools_text"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_text">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_text" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pocketpaint_tools_stamp"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_clipboard">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_clipboard" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_clipboard" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pocketpaint_tools_transform"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_transform">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_transform" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_transform" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pocketpaint_tools_import"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_import_image">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_import" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_import_image" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 4: Pipette, Watercolor, Smudge, Clip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/pocketpaint_tools_pipette"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_pipette">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_pipette" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_pipette" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pocketpaint_tools_watercolor"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_watercolor">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_watercolor" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_watercolor" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pocketpaint_tools_smudge"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_smudge">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_smudge" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_smudge" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pocketpaint_tools_clipping"
                style="@style/PocketPaintToolGridCell"
                android:contentDescription="@string/button_clip">
                <ImageView
                    style="@style/PocketPaintToolGridIcon"
                    android:src="@drawable/ic_pocketpaint_tool_clipping" />
                <TextView
                    style="@style/PocketPaintToolGridLabel"
                    android:text="@string/button_clip" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
