<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <CheckBox
        android:id="@+id/brick_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <org.catrobat.catroid.ui.BrickLayout
        style="@style/BrickContainer.Motion.Big"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/icon_brick_category_motion" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_create_3d_joystick_label" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_create_3d_object_name" />

        <TextView
            android:id="@+id/brick_create_3d_joystick_object"
            style="@style/BrickEditText" />

        <TextView
            android:id="@+id/brick_create_3d_joystick_x"
            style="@style/BrickEditText" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_joystick_pos_y" />

        <TextView
            android:id="@+id/brick_create_3d_joystick_y"
            style="@style/BrickEditText" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_joystick_bg_file" />

        <TextView
            android:id="@+id/brick_create_3d_joystick_bg"
            style="@style/BrickEditText" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_joystick_thumb_file" />

        <TextView
            android:id="@+id/brick_create_3d_joystick_thumb"
            style="@style/BrickEditText" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_joystick_speed" />

        <TextView
            android:id="@+id/brick_create_3d_joystick_speed"
            style="@style/BrickEditText" />

    </org.catrobat.catroid.ui.BrickLayout>

</LinearLayout>
