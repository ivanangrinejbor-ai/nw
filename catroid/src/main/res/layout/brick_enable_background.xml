<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <CheckBox android:id="@+id/brick_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_enable_background_layout"
        style="@style/BrickContainer.Device.Big">

        <include layout="@layout/icon_brick_category_device" />

        <TextView style="@style/BrickText.SingleLine"
            android:text="@string/brick_enable_background" />

        <TextView style="@style/BrickText.SingleLine"
            android:text="@string/brick_prepare_notification_id"
            app:layout_newLine="true" />
        <TextView android:id="@+id/brick_enable_background_edit_id"
            style="@style/BrickEditText" />

        <TextView style="@style/BrickText.SingleLine"
            android:text="@string/brick_prepare_notification_channel"
            app:layout_newLine="true" />
        <TextView android:id="@+id/brick_enable_background_edit_channel"
            style="@style/BrickEditText" />

        <TextView style="@style/BrickText.SingleLine"
            android:text="@string/brick_prepare_notification_title"
            app:layout_newLine="true" />
        <TextView android:id="@+id/brick_enable_background_edit_title"
            style="@style/BrickEditText" />

        <TextView style="@style/BrickText.SingleLine"
            android:text="@string/brick_prepare_notification_text"
            app:layout_newLine="true" />
        <TextView android:id="@+id/brick_enable_background_edit_text"
            style="@style/BrickEditText" />

        <TextView style="@style/BrickText.SingleLine"
            android:text="@string/brick_prepare_notification_icon"
            app:layout_newLine="true" />
        <TextView android:id="@+id/brick_enable_background_edit_icon"
            style="@style/BrickEditText" />

        <TextView style="@style/BrickText.SingleLine"
            android:text="@string/brick_prepare_notification_importance"
            app:layout_newLine="true" />
        <Spinner android:id="@+id/brick_enable_background_importance_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textDirection="locale" />
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>
