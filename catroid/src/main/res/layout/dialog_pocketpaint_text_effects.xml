<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp">

    <CheckBox
        android:id="@+id/chk_fx_stroke"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_fx_stroke" />

    <Button
        android:id="@+id/btn_fx_stroke_color"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/text_fx_color" />

    <CheckBox
        android:id="@+id/chk_fx_glow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_fx_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <SeekBar
            android:id="@+id/seek_fx_glow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="9" />

        <Button
            android:id="@+id/btn_fx_glow_color"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/text_fx_color" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/chk_fx_shadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_fx_shadow" />

    <Button
        android:id="@+id/btn_fx_shadow_color"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/text_fx_color" />

    <CheckBox
        android:id="@+id/chk_fx_gradient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_fx_gradient" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_fx_gradient_top" />

        <Button
            android:id="@+id/btn_fx_grad_top"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/text_fx_color" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/text_fx_gradient_bottom" />

        <Button
            android:id="@+id/btn_fx_grad_bottom"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/text_fx_color" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/chk_fx_pixel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_fx_pixel_crisp" />

    <CheckBox
        android:id="@+id/chk_fx_dim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/text_fx_dim_background" />
</LinearLayout>
