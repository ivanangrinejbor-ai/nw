<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/brick_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_upload_firebase_layout"
        style="@style/BrickContainer.Internet.Big">

        <include layout="@layout/icon_brick_category_internet" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/firebase_upload" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/firebase_bucket"
            app:layout_newLine="true"/>

        <TextView
            android:id="@+id/brick_upload_firebase_bucket"
            style="@style/BrickEditText" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/firebase_storage_path"
            app:layout_newLine="true"/>

        <TextView
            android:id="@+id/brick_upload_firebase_path"
            style="@style/BrickEditText" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/firebase_local_file"
            app:layout_newLine="true"/>

        <TextView
            android:id="@+id/brick_upload_firebase_file"
            style="@style/BrickEditText" />

    </org.catrobat.catroid.ui.BrickLayout>

</LinearLayout>
