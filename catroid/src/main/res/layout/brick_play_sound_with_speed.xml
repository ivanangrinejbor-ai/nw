<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <CheckBox android:id="@+id/brick_checkbox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
    <org.catrobat.catroid.ui.BrickLayout style="@style/BrickContainer.Sound.Small">
        <include layout="@layout/icon_brick_category_sound" />
        <TextView style="@style/BrickText.SingleLine" android:text="@string/brick_play_sound_with_speed" />
        <Spinner android:id="@+id/brick_play_sound_speed_spinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView style="@style/BrickText.SingleLine" android:text="@string/brick_play_sound_with_speed_param" />
        <TextView android:id="@+id/brick_play_sound_speed_edit" style="@style/BrickEditText" />
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>
