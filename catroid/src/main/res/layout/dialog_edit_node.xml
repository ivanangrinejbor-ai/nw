<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/et_node_textid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="text_id (for l10n)"
            android:textColor="#FFFFFF"
            android:textColorHint="#606060"
            android:backgroundTint="#808080"
            android:visibility="gone"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_node_speaker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Speaker"
            android:textColor="#FFFFFF"
            android:textColorHint="#808080"
            android:backgroundTint="#808080"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_node_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dialogue text"
            android:textColor="#FFFFFF"
            android:textColorHint="#808080"
            android:backgroundTint="#808080"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_node_portrait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Portrait path"
            android:textColor="#FFFFFF"
            android:textColorHint="#808080"
            android:backgroundTint="#808080"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_node_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Voice sound path"
            android:textColor="#FFFFFF"
            android:textColorHint="#808080"
            android:backgroundTint="#808080"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_node_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Typing speed (0.05)"
            android:textColor="#FFFFFF"
            android:textColorHint="#808080"
            android:backgroundTint="#808080"
            android:inputType="numberDecimal"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/et_node_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Background image path"
            android:textColor="#FFFFFF"
            android:textColorHint="#808080"
            android:backgroundTint="#808080"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
