<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1A1A2E">

    <!-- Top toolbar -->
    <LinearLayout
        android:id="@+id/hitbox_toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:background="#FF16213E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/hitbox_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/hitbox_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/hitbox_editor_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/hitbox_btn_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hitbox_add"
            android:src="@android:drawable/ic_menu_add"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/hitbox_btn_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hitbox_delete"
            android:src="@android:drawable/ic_menu_delete"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/hitbox_btn_save"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hitbox_save"
            android:src="@android:drawable/ic_menu_save"
            android:scaleType="centerInside" />
    </LinearLayout>

    <!-- Canvas where the sprite + hitboxes are drawn -->
    <org.catrobat.catroid.ui.hitbox.HitboxEditorView
        android:id="@+id/hitbox_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/hitbox_toolbar" />

    <!-- Bottom hint bar -->
    <TextView
        android:id="@+id/hitbox_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#AA16213E"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/hitbox_hint_default"
        android:textColor="#AAFFFFFF"
        android:textSize="12sp" />

</RelativeLayout>
