<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- Top Glassmorphic Toolbar -->
    <LinearLayout
        android:id="@+id/hitbox_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#151D2F"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/hitbox_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
        <!-- TODO: Replace ic_menu_close_clear_cancel with a proper navigation
             icon like ic_arrow_back if available. The current icon is a
             "close/cancel" symbol, not a back-arrow navigation affordance. -->

        <TextView
            android:id="@+id/hitbox_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/hitbox_editor_title"
            android:textColor="#F8FAFC"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/hitbox_btn_add"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hitbox_add"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_add" />

        <ImageButton
            android:id="@+id/hitbox_btn_delete"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hitbox_delete"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_delete" />

        <ImageButton
            android:id="@+id/hitbox_btn_save"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hitbox_save"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_save" />
    </LinearLayout>

    <!-- Canvas where the sprite + hitboxes are drawn -->
    <org.catrobat.catroid.ui.hitbox.HitboxEditorView
        android:id="@+id/hitbox_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/hitbox_toolbar" />

    <!-- Bottom Floating Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:background="#D91E293B"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/hitbox_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/hitbox_hint_default"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

</RelativeLayout>
