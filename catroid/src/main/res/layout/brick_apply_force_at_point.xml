<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <CheckBox android:id="@+id/brick_checkbox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
    <org.catrobat.catroid.ui.BrickLayout style="@style/BrickContainer.Motion.Medium">
        <include layout="@layout/icon_brick_category_motion" />
        <TextView style="@style/BrickText.SingleLine" android:text="@string/brick_apply_force_at_point" />
        <TextView android:id="@+id/brick_force_at_point_fx" style="@style/BrickEditText" />
        <TextView android:id="@+id/brick_force_at_point_fy" style="@style/BrickEditText" />
        <TextView style="@style/BrickText.SingleLine" android:text="@string/brick_apply_force_at_point_x" />
        <TextView android:id="@+id/brick_force_at_point_px" style="@style/BrickEditText" />
        <TextView style="@style/BrickText.SingleLine" android:text="@string/brick_apply_force_at_point_y" />
        <TextView android:id="@+id/brick_force_at_point_py" style="@style/BrickEditText" />
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>
