<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/brick_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_rotate_towards_target_layout"
        style="@style/BrickContainer.Motion.Medium">

        <include layout="@layout/icon_brick_category_motion" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_rotate_towards_target" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_rotate_towards_x" />

        <TextView
            android:id="@+id/brick_rotate_towards_target_x_edit_text"
            style="@style/BrickEditText" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_rotate_towards_y" />

        <TextView
            android:id="@+id/brick_rotate_towards_target_y_edit_text"
            style="@style/BrickEditText" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_rotate_towards_speed" />

        <TextView
            android:id="@+id/brick_rotate_towards_target_speed_edit_text"
            style="@style/BrickEditText" />

    </org.catrobat.catroid.ui.BrickLayout>

</LinearLayout>
