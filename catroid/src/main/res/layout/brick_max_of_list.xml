<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/brick_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_max_of_list_layout"
        style="@style/BrickContainer.Data.Medium">

        <include layout="@layout/icon_brick_category_data" />

        <TextView
            android:id="@+id/max_of_list_label"
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_max_of_list" />

        <Spinner
            android:id="@+id/max_list_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/max_to_label"
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_store_in" />

        <Spinner
            android:id="@+id/max_var_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </org.catrobat.catroid.ui.BrickLayout>

</LinearLayout>
