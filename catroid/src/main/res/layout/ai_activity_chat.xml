<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/ai_chat_background">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:scrollbars="none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:background="@drawable/ai_input_bar_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:elevation="12dp">

        <EditText
            android:id="@+id/chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:hint="@string/ai_agent_chat_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:minHeight="46dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:background="@drawable/chat_input_background"
            android:textColor="@color/ai_text_primary"
            android:textColorHint="@color/ai_text_secondary"
            android:textSize="15sp"
            android:gravity="center_vertical|start" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_gravity="bottom"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send"
            android:background="@drawable/ai_send_button_bg"
            android:contentDescription="@string/ai_agent_send" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/chat_bottom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/ai_surface"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="2dp"
        android:paddingBottom="12dp"
        android:elevation="12dp">

        <TextView
            android:id="@+id/btn_model"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:maxWidth="240dp"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:drawableEnd="@drawable/ic_model_dropdown"
            android:drawablePadding="4dp"
            android:background="@drawable/ai_model_button_bg"
            android:textColor="@color/ai_text_primary"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/ai_agent_select_model_title" />

    </LinearLayout>

</LinearLayout>
