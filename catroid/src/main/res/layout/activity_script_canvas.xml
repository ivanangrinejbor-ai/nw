<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/script_canvas_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/script_canvas_toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#151D2F"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/script_canvas_btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/script_canvas_close"
                android:scaleType="centerInside"
                android:src="@drawable/ic_se_close" />

            <TextView
                android:id="@+id/script_canvas_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F8FAFC"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/script_canvas_btn_undo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Отмена"
                android:scaleType="centerInside"
                android:src="@drawable/ic_se_minimize" />

            <ImageButton
                android:id="@+id/script_canvas_btn_redo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Повтор"
                android:scaleType="centerInside"
                android:src="@drawable/ic_se_add" />

            <ImageButton
                android:id="@+id/script_canvas_btn_data"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Данные"
                android:scaleType="centerInside"
                android:src="@drawable/ic_se_more" />

            <ImageButton
                android:id="@+id/script_canvas_btn_import_neoscript"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Импорт NeoScript"
                android:scaleType="centerInside"
                android:src="@drawable/ic_se_scene_switcher" />

            <ImageButton
                android:id="@+id/script_canvas_btn_backpack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/script_canvas_backpack"
                android:scaleType="centerInside"
                android:src="@drawable/ic_se_backpack" />

            <ImageButton
                android:id="@+id/script_canvas_btn_palette"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/script_canvas_palette"
                android:scaleType="centerInside"
                android:src="@drawable/ic_se_add" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/script_canvas_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/script_canvas_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/script_canvas_empty"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/script_palette"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="#F2101826"
        android:elevation="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/script_palette_search"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_margin="8dp"
            android:background="#2233E0FF"
            android:hint="🔍 Поиск блоков по имени..."
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#152036"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/script_palette_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp" />
        </HorizontalScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/script_palette_bricks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/script_canvas_drag_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
