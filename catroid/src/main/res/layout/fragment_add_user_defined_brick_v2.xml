<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_add_user_defined_brick_v2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="Block Name:"
            android:layout_marginBottom="4dp"
            android:textColor="@color/solid_white" />

        <EditText
            android:id="@+id/edit_block_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. MoveAndBounce"
            android:singleLine="true"
            android:textColor="@color/solid_white"
            android:textColorHint="@android:color/darker_gray"
            android:layout_marginBottom="16dp" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="Parameters ($1, $2, etc.):"
            android:layout_marginBottom="8dp"
            android:textColor="@color/solid_white" />

        <LinearLayout
            android:id="@+id/parameters_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/button_add_parameter"
            android:text="Add Parameter"
            style="@style/Button"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>
