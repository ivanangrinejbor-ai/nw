<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/brick_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_head_web_request_layout"
        style="@style/BrickContainer.UserVariables.Big">

        <include layout="@layout/icon_brick_category_data" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/head_web_request" />

        <TextView
            android:id="@+id/brick_head_web_request_edit_url"
            style="@style/BrickEditText"
            app:layout_newLine="true"/>

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/head_web_request_header"
            app:layout_newLine="true"/>

        <TextView
            android:id="@+id/brick_head_web_request_edit_header"
            style="@style/BrickEditText"
            app:layout_newLine="true"/>

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/head_web_request_timeout"
            app:layout_newLine="true"/>

        <TextView
            android:id="@+id/brick_head_web_request_edit_timeout"
            style="@style/BrickEditText"
            app:layout_newLine="true"/>

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/head_web_request_var"
            app:layout_newLine="true"/>

         <Spinner
             android:id="@+id/head_web_request_spinner"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:textDirection="locale" />

    </org.catrobat.catroid.ui.BrickLayout>

</LinearLayout>
