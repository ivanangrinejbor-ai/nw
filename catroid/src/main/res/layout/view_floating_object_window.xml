<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F21E293B"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/floating_window_header"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#2B3A55"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/floating_window_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/floating_window_minimize"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/scene_editor_window_minimize"
                android:scaleType="centerInside"
                android:src="@drawable/ic_se_minimize" />

            <ImageButton
                android:id="@+id/floating_window_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/scene_editor_window_close"
                android:scaleType="centerInside"
                android:src="@drawable/ic_se_close" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/floating_window_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/floating_window_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/floating_window_add_blocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/scene_editor_add_blocks_bg"
                android:elevation="3dp"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:stateListAnimator="@null"
                android:text="@string/scene_editor_window_add_blocks"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/floating_window_looks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/scene_editor_add_blocks_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:stateListAnimator="@null"
                    android:text="Образы"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF" />

                <Button
                    android:id="@+id/floating_window_sounds"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/scene_editor_add_blocks_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:stateListAnimator="@null"
                    android:text="Звуки"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/floating_window_layers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/scene_editor_add_blocks_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:stateListAnimator="@null"
                    android:text="Слои"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF" />

                <Button
                    android:id="@+id/floating_window_inspector"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/scene_editor_add_blocks_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:stateListAnimator="@null"
                    android:text="Инспектор"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <Button
                android:id="@+id/floating_window_swipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/scene_editor_add_blocks_bg"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:stateListAnimator="@null"
                android:text="@string/scene_editor_swipe"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/floating_window_resize"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="@string/scene_editor_window_resize"
        android:padding="4dp"
        android:src="@drawable/ic_se_resize" />

</FrameLayout>
