<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#1A1A2E"
    android:padding="32dp">

    <ImageView
        android:id="@+id/v3_runtime_logo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Logo"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/v3_runtime_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/v3_loading_title"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <ProgressBar
        android:id="@+id/v3_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginBottom="12dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#E94560"
        android:indeterminateTint="#E94560" />

    <TextView
        android:id="@+id/v3_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/v3_loading"
        android:textSize="15sp"
        android:textColor="#CCCCCC"
        android:layout_marginBottom="48dp" />

    <TextView
        android:id="@+id/v3_fact_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="#888888"
        android:gravity="center"
        android:maxLines="3"
        android:layout_marginHorizontal="16dp" />

</LinearLayout>
