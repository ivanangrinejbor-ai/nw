<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/v3_progress_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/v3_building_apk"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/dialog_title_and_text_view"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/v3_progress_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="@color/progress_blue"
        android:layout_marginBottom="14dp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/v3_build_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        app:trackThickness="10dp"
        app:trackCornerRadius="6dp"
        app:indicatorColor="@color/progress_blue"
        app:trackColor="@color/progress_blue_track"
        android:layout_marginBottom="18dp" />

    <TextView
        android:id="@+id/v3_progress_stage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/v3_preparing"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="@color/checkbox_and_radio_button_description"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/v3_progress_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/spinner_icon_and_inactive_elements"
        android:gravity="center"
        android:maxLines="2"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/v3_build_fact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/spinner_icon_and_inactive_elements"
        android:gravity="center"
        android:maxLines="3"
        android:layout_marginHorizontal="8dp" />

</LinearLayout>
