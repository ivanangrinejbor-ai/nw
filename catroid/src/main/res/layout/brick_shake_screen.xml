<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/brick_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_shake_screen_layout"
        style="@style/BrickContainer.Control.Medium">

        <include layout="@layout/icon_brick_category_control" />

        <TextView
            style="@style/BrickText.SingleLine"
            android:text="@string/brick_shake_screen">
        </TextView>

        <TextView
            android:id="@+id/brick_shake_screen_label_int"
            style="@style/BrickText.SingleLine"
            app:layout_newLine="true"
            android:text="@string/brick_shake_screen_intensity">
        </TextView>

        <TextView
            android:id="@+id/brick_shake_screen_int_edit"
            style="@style/BrickEditText">
        </TextView>

        <TextView
            android:id="@+id/brick_shake_screen_label_dur"
            style="@style/BrickText.SingleLine"
            app:layout_newLine="true"
            android:text="@string/brick_shake_screen_duration">
        </TextView>

        <TextView
            android:id="@+id/brick_shake_screen_dur_edit"
            style="@style/BrickEditText">
        </TextView>
    </org.catrobat.catroid.ui.BrickLayout>

</LinearLayout>
