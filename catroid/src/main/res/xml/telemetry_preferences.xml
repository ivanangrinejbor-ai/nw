        <Preference
            android:key="telemetry_usage_no_delete"
            android:selectable="false"
            android:summary="@string/telemetry_usage_no_delete_desc"
            android:title="@string/telemetry_usage_no_delete" />

        <Preference
            android:key="telemetry_usage_uuid"
            android:selectable="false"
            android:summary="@string/telemetry_usage_uuid_desc"
            android:title="@string/telemetry_usage_uuid" />

        <Preference
            android:key="telemetry_usage_no_ads"
            android:selectable="false"
            android:summary="@string/telemetry_usage_no_ads_desc"
            android:title="@string/telemetry_usage_no_ads" />

    </PreferenceCategory>

    <Preference
        android:key="telemetry_privacy_policy"
        android:layout="@layout/preference_telemetry_privacy_button"
        android:title="@string/telemetry_privacy_policy" />

</PreferenceScreen>
